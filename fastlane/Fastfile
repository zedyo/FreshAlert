default_platform(:ios)
require "base64"

PROJECT     = "FreshAlert.xcodeproj"
SCHEME      = "FreshAlert"
APP_ID      = "com.freshalert.app"
WIDGET_ID   = "com.freshalert.app.widget"

# Die ersten TestFlight-Builds (Mai 2026) trugen die Nummern 21 und 22.
# Build-Nummer = Commit-Anzahl + Versatz, damit sie streng steigt und
# auf dem iMac wie in der Cloud dieselbe ist.
BUILD_NUMBER_OFFSET = 100

platform :ios do

  def asc_api_key
    app_store_connect_api_key(
      key_id:                ENV.fetch("ASC_KEY_ID"),
      issuer_id:             ENV.fetch("ASC_ISSUER_ID"),
      key_content:           ENV.fetch("ASC_KEY_CONTENT"),
      is_key_content_base64: true
    )
  end

  # Ersten verfügbaren iPhone-Simulator nehmen, statt einen festen Namen zu
  # verlangen, der mit jeder Xcode-Version wechselt.
  def simulator_destination
    list = sh("xcrun simctl list devices available", log: false)
    name = list.lines.map(&:strip).find { |l| l.start_with?("iPhone") }&.sub(/ \(.*/, "")
    "platform=iOS Simulator,name=#{name || 'iPhone 17'}"
  end

  def next_build_number
    (number_of_commits(all: true) + BUILD_NUMBER_OFFSET).to_s
  end

  # --- Qualitätstor ---------------------------------------------------------
  desc "Unit-Tests im Simulator"
  lane :test do
    run_tests(
      project:       PROJECT,
      scheme:        SCHEME,
      destination:   simulator_destination,
      code_coverage: true
    )
  end

  # --- TestFlight -----------------------------------------------------------
  desc "Tests, signierter Release-Build, Upload zu TestFlight"
  lane :beta do
    test

    api_key = asc_api_key
    increment_build_number(xcodeproj: PROJECT, build_number: next_build_number)

    # Signierung über Apples Cloud-Zertifikate mit dem API-Schlüssel (Rolle Admin),
    # kein match, kein Zertifikate-Repo. Der Schlüssel liegt als Datei vor,
    # damit xcodebuild ihn direkt lesen kann.
    key_path = File.expand_path("../.asc_key.p8", __dir__)
    File.write(key_path, Base64.decode64(ENV.fetch("ASC_KEY_CONTENT")))
    auth = "-allowProvisioningUpdates -authenticationKeyPath #{key_path} " \
           "-authenticationKeyID #{ENV.fetch('ASC_KEY_ID')} " \
           "-authenticationKeyIssuerID #{ENV.fetch('ASC_ISSUER_ID')}"
    build_app(
      project:       PROJECT,
      scheme:        SCHEME,
      export_method: "app-store",
      xcargs:        auth,
      export_options: { signingStyle: "automatic", uploadSymbols: true, teamID: "92P4377WNF" }
    )
    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: false)
  ensure
    File.delete(key_path) if key_path && File.exist?(key_path)
  end

  # --- App Store ------------------------------------------------------------
  desc "Version aus Tag setzen, TestFlight-Build erzeugen, zur Prüfung einreichen. Veröffentlichung bleibt manuell."
  lane :release do |options|
    if options[:version]
      increment_version_number(xcodeproj: PROJECT, version_number: options[:version])
    end

    beta

    deliver(
      api_key:            asc_api_key,
      submit_for_review:  true,
      automatic_release:  false,
      force:              true,
      skip_binary_upload: true,
      skip_screenshots:   true,
      skip_metadata:      true,
      precheck_include_in_app_purchases: false
    )
  end
end
